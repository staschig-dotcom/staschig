<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Погода"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Город для прогноза (данные Open-Meteo, без регистрации и ключей)." />

        <EditText
            android:id="@+id/city_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Например: Москва"
            android:imeOptions="actionDone"
            android:inputType="textCapWords"
            android:singleLine="true" />

        <Button
            android:id="@+id/city_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сохранить и обновить" />

        <TextView
            android:id="@+id/weather_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="2. Сообщения приложений"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/access_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/access_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Доступ к уведомлениям" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Длина текста сообщения в виджете:" />

        <RadioGroup
            android:id="@+id/msg_lines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/msg_lines_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 строки" />

            <RadioButton
                android:id="@+id/msg_lines_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 строк" />

            <RadioButton
                android:id="@+id/msg_lines_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Целиком" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="3. Календарь"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/calendar_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/calendar_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Разрешить доступ к календарю" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="4. Виджет"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Виджет занимает весь экран (4×6). Сначала сделайте пустой экран: долгое нажатие на рабочем столе → пролистайте вправо до пустой страницы (или уберите с главного экрана значки). Затем нажмите кнопку ниже или: долгое нажатие → Виджеты → «Инфо-виджет». Если не встал на весь экран — долгое нажатие на виджет и растяните за края." />

        <TextView
            android:id="@+id/opacity_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <SeekBar
            android:id="@+id/opacity_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <Button
            android:id="@+id/pin_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Добавить на рабочий стол" />

        <LinearLayout
            android:id="@+id/miui_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="5. Xiaomi (MIUI) — обязательно"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="MIUI выгружает фоновые службы: без этих двух настроек сообщения в виджете перестанут обновляться через несколько часов, а погода — после перезагрузки.\n1) Автозапуск — включить для «Инфо-виджет».\n2) Контроль активности (батарея) — «Нет ограничений»." />

            <Button
                android:id="@+id/miui_autostart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Автозапуск" />

            <Button
                android:id="@+id/miui_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Батарея: без ограничений" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
